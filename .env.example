# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill it in. Never commit .env.local.
# The app refuses to start if any variable marked REQUIRED is missing,
# and it will tell you which one. See lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED — Supabase. Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key. BACKEND ONLY. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# REQUIRED — Postgres connection string. Supabase: Project Settings >
# Database > Connection string > URI. Use the pooled (port 6543) one on Vercel.
# Encode special characters in the password first (@ % # / : are unsafe in a
# URL) — Supabase-generated passwords often contain them.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-encoded-password@aws-0-region.pooler.supabase.com:6543/postgres

# REQUIRED — the app's own public URL. Used to build share links and the
# magic-link redirect. http://localhost:3000 in development.
APP_URL=http://localhost:3000

# OPTIONAL — Gmail SMTP, for the app's own client-delivery and
# approver-notification emails (a separate concern from Supabase Auth's
# own magic-link emails, configured in the Supabase dashboard, not here).
# Without these the app still works: it skips sending and records a
# 'skipped: no email provider configured' event instead of failing.
#
# GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is a 16-character
# App Password (Google Account > Security > 2-Step Verification > App
# passwords) — NOT your normal Gmail password. The "from" address on every
# email is always this Gmail address; MAIL_FROM_NAME only customises the
# display name in front of it.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME="Koya Talent"

# OPTIONAL — where approval-request emails go if the proposal has no named
# approver yet. Handy while there is only one of you testing.
DEFAULT_APPROVER_EMAIL=

# OPTIONAL — the shared secret guarding the scheduled follow-up job at
# /api/cron/nudge, which emails a client a reminder two days after a
# proposal is sent if they haven't answered. Without this set, that endpoint
# refuses to run at all rather than running unsecured. On Vercel, set the
# same value in the project's environment variables — Vercel Cron sends it
# automatically as `Authorization: Bearer <CRON_SECRET>`. Any long random
# string: `openssl rand -base64 32`.
CRON_SECRET=

# OPTIONAL — set to 1 to use the recorded Claude replies in test/fixtures
# instead of calling the real API. Used by the scenario harness.
MOCK_ANTHROPIC=0
